# Copie este archivo como .env en la raíz y cambie todos los valores.
# No incluya secretos reales en el repositorio.

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=akira_educacion
POSTGRES_USER=akira_app
POSTGRES_PASSWORD=cambie-esta-clave-de-base-de-datos
DB_SCHEMA=akira

# --- Backend ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Mínimo 32 bytes. Genere uno con: openssl rand -base64 48
JWT_SECRET=cambie-este-secreto-de-al-menos-32-caracteres
JWT_ISSUER=akira-educacion
JWT_TTL=PT1H
OPENAPI_ENABLED=false

# --- Frontend / CORS --------------------------------------------------------
FRONTEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Zona horaria del contenedor -------------------------------------------
TZ=America/Guayaquil
